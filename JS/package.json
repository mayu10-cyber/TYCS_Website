{
  "name": "internship",
  "version": "1.0.0",
  "main": "script.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start-all": "concurrently \"node server.js\" \"node chatbotserver.js\" \"node booking.js\" \"node reviewserver.js\"",
    "start": "node server.js",
    "start:reviews": "node reviewserver.js",
    "migrate:reviews": "node migrateReviews.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "NODE_ENV=development node server.js",
    "install:prod": "npm install --production",
    "build": "echo 'No build step required for Node.js app'",
    "pm2:start": "pm2 start server.js --name 'tycs-email-server'",
    "pm2:stop": "pm2 stop tycs-email-server",
    "pm2:restart": "pm2 restart tycs-email-server",
    "pm2:logs": "pm2 logs tycs-email-server"
  },
  "keywords": [
    "email",
    "contact-form",
    "tycs",
    "production"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.9.0",
    "body-parser": "^2.2.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "firebase": "^11.9.0",
    "mongoose": "^8.16.0",
    "multer": "^2.0.1",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "open": "^10.1.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "description": "TYCS Email Server for Production Contact Forms"
}
